ANTHROPIC_API_KEY=sk-ant-...

# Postgres, and only Postgres (ADR 0003) — no SQLite fallback. Start the local
# server with `docker compose up -d db` (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://journal:journal@localhost:5432/journal
# scripts/dev.sh sets this for you in both modes. The app refuses to boot
# without it. Schema is managed by Alembic (`alembic upgrade head`).
#
# Runs that upgrade at startup. On (default) keeps dev a one-liner. Set to 0
# in production and run `alembic upgrade head` as an explicit deploy step —
# otherwise DDL hits real data with no checkpoint and N workers race to apply
# it. A failed migration aborts boot rather than serving on an unknown schema.
# AUTO_MIGRATE=0
#
# Skip the startup Keep sync during dev so `uvicorn --reload` doesn't re-sync
# on every save (real mode syncs by default):
# SYNC_ON_STARTUP=0

# Freemium daily LLM budgets in dollars, UTC-day window (ADR 0003, F2).
# The quota gate refuses an LLM call once spend >= budget — BEFORE spending.
# Defaults: free tier $0 (keyless users get a friendly refusal; BYO keys are
# F4), demo $1 (keeps the showcase alive), global cap $5 (the kill-switch —
# bounds the worst day the shared API key can have, system work included).
# FREE_TIER_DAILY_USD=0
# DEMO_DAILY_USD=1
# GLOBAL_DAILY_USD=5

# Which peers are allowed to speak for someone else. Comma-separated addresses
# (CIDR allowed) of the reverse proxy directly in front of the app — the trust
# boundary every per-IP rate limit rests on. Unset (default) = X-Forwarded-For
# is ignored outright. backend/Dockerfile passes this same value to uvicorn's
# --forwarded-allow-ips. See the manifest at the bottom — a wrong value here
# voids every limit without any error.
# TRUSTED_PROXY_IPS=10.0.0.1,10.0.0.2

# Per-identity rate limits: requests per fixed window, per caller, per route
# tier (services/rate_limit.py). Keyed on user id when signed in, address
# otherwise. 0 disables that window — also the per-tier escape hatch. Shown
# at shipped defaults; the numbers are budgets for what a request costs us.
# RATE_LIMIT_CHAT_PER_MIN=5           # three LLM calls per request
# RATE_LIMIT_CHAT_PER_HOUR=40
# RATE_LIMIT_SYNTHESIS_PER_MIN=10     # one LLM call, LRU-cached
# RATE_LIMIT_SYNTHESIS_PER_HOUR=60
# RATE_LIMIT_INGEST_PER_MIN=5         # inline OCR + a background scoring call
# RATE_LIMIT_INGEST_PER_HOUR=30
# RATE_LIMIT_KEYS_PER_MIN=5           # live Anthropic auth check, no quota gate
# RATE_LIMIT_KEYS_PER_HOUR=20
# RATE_LIMIT_SEARCH_PER_MIN=30        # local ONNX encode; CPU, not money
# RATE_LIMIT_SEARCH_PER_HOUR=0
# RATE_LIMIT_AUTH_PER_MIN=10          # login handshake, always per IP
# RATE_LIMIT_AUTH_PER_HOUR=0

# Public demo — the only demo switch. When on, an unauthenticated request falls
# back to the seeded demo user (read-only, DEMO_DAILY_USD budget) instead of
# 401, and signing in gives the caller their own journal. Off (default) =
# private instance. Seed first: `DATABASE_URL=…pg… python scripts/seed_demo.py`.
# Pair it with SYNC_ON_STARTUP=0 unless this instance owns the Keep account.
# PUBLIC_DEMO=1

# Google Keep ingestion (omit to disable Keep sync entirely):
GOOGLE_EMAIL=you@gmail.com
GOOGLE_APP_MASTER_TOKEN=aas_et/...

# Sign in with Google (multi-user auth — ADR 0003). NOT the Keep creds above.
# From Google Cloud Console → APIs & Services → Credentials → Create OAuth
# client ID → type "Web application", authorized redirect URI:
#   http://localhost:8000/auth/callback
GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
#
# Signs the short-lived cookie carrying the in-flight OAuth state. Unset →
# random per boot (fine in dev; a restart only drops logins mid-handshake).
# Pin in production: python -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
#
# Where /auth/callback sends the browser after login (the SPA origin):
# FRONTEND_URL=http://localhost:5173
#
# `Secure` on the session cookie. On by default; browsers accept Secure
# cookies on http://localhost, so dev needs no change. Never set 0 in
# production — it's what keeps the session token off the wire.
# COOKIE_SECURE=1

# Where fastembed caches the ~90 MB embedding model. Unset → the system temp
# dir, which cold starts wipe, turning the first search into a synchronous
# download inside the request. backend/Dockerfile bakes the model in at
# /opt/fastembed and sets this for you; set it by hand only outside Docker.
# FASTEMBED_CACHE_DIR=/opt/fastembed

# GoodNotes ingestion. Point at the local folder holding the exported PDF.
# Requires Full Disk Access (System Settings → Privacy → Full Disk Access).
# Plain path, no shell escaping.
#
# Prefer the PARENT folder over the notebook subfolder: Google Drive renames
# the subfolder on re-upload ("Notes" → "Notes (1)"), which would point this
# at a folder that no longer exists (now an ERROR + `error` key, not a
# silent zero-page scan).
GOODNOTES_PATH=~/Library/CloudStorage/GoogleDrive-you@gmail.com/My Drive/GoodNotes
#
# Minutes between scheduled GoodNotes folder scans. 0 (default) = off — only
# a manual POST /ingest?source=goodnotes picks up new pages. First scan runs
# one interval after boot, not at boot.
GOODNOTES_SCAN_INTERVAL_MIN=60


# ---------------------------------------------------------------------------
# Production deploy manifest
# ---------------------------------------------------------------------------
# MUST be set (the app is wrong or insecure without them):
#   DATABASE_URL              managed Postgres, with the pgvector extension
#                             at **version 0.8 or newer** — older versions
#                             reject hnsw.iterative_scan, so filtered ANN
#                             silently loses recall as the table grows
#                             (services/embeddings.py). Check with:
#                               SELECT extversion FROM pg_extension
#                               WHERE extname = 'vector';
#                             URL-encode reserved characters in the password
#                             (%40 for @).
#   ANTHROPIC_API_KEY         the operator key; every keyless user spends on it
#   APP_ENCRYPTION_KEY        Fernet key for BYO keys at rest. Losing or rotating
#                             it makes every stored user key undecryptable.
#   SESSION_SECRET            pin it, or multi-worker OAuth login breaks: the
#                             state cookie is signed per-process
#   FRONTEND_URL              the SPA origin — also the CORS allow-list entry
#   GOOGLE_OAUTH_CLIENT_ID    with the production redirect URI registered in the
#   GOOGLE_OAUTH_CLIENT_SECRET  Google console: https://<api-host>/auth/callback
#   AUTO_MIGRATE=0            run `alembic upgrade head` as a deploy step instead
#   TRUSTED_PROXY_IPS         the reverse proxy / load balancer directly in
#                             front of the app — the trust boundary for rate
#                             limiting, wrong SILENTLY in both directions. Too
#                             wide ("*") lets any caller forge X-Forwarded-For
#                             and void every per-IP limit; too narrow (unset,
#                             behind a real balancer) buckets the whole
#                             internet as one caller. Verify after deploying:
#                             requests from different networks must land in
#                             different buckets. backend/Dockerfile passes this
#                             same value to uvicorn's --forwarded-allow-ips.
#
# SHOULD be reviewed before going live:
#   COOKIE_SECURE=1           (default) — leave it on
#   GLOBAL_DAILY_USD          the kill-switch. This is the hard bound on what a
#                             bad day can cost you. Set it deliberately low.
#   RATE_LIMIT_*              the shipped defaults assume a personal-scale
#                             instance. Raise them for a busier one; lower the
#                             chat tier first if the LLM bill is the worry.
#   PUBLIC_DEMO               leave UNSET unless you have read the caveat below
#
# LEAVE UNSET in production:
#   GOOGLE_EMAIL / GOOGLE_APP_MASTER_TOKEN / GOODNOTES_PATH — the connector sync
#   routes resolve their owner from GOOGLE_EMAIL and ignore the caller, so with
#   these set any signed-in user can trigger a sync into that account.
#
# PUBLIC_DEMO caveat: makes every route reachable with no credential, resolving
# to the shared demo account. Rate limits bound how OFTEN an anonymous visitor
# can reach expensive routes — sound only if TRUSTED_PROXY_IPS is set first.
# They bound rate, not spend: quota is still read-then-act, so concurrent
# requests can overshoot DEMO_DAILY_USD; GLOBAL_DAILY_USD is the hard stop.
