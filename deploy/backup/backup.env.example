# cp to /etc/journal-backup/backup.env (chmod 600) and fill in. Read by
# journal-backup.service; every value overrides a default in backup.sh.
# systemd EnvironmentFile syntax: KEY=value, no export, no shell expansion.

# Public key that backups are encrypted to. Generate the pair OFF this box:
#   age-keygen -o journal-backup.key   # keep the private half elsewhere
# The public line is the one starting age1.
AGE_RECIPIENT=age1...

# Or, for more than one recipient, a file of public keys, one per line.
# Takes effect only when AGE_RECIPIENT is unset.
# AGE_RECIPIENTS_FILE=/etc/journal-backup/recipients.txt

BACKUP_DIR=/var/backups/journal

# Newest N local runs kept. Offsite retention is the destination's job.
KEEP=14

# Offsite destination. Default is a directory on the same disk, which is not a
# backup. One of:
#   /mnt/some-other-volume/journal
#   rclone:b2:journal-backups/prod
#   ssh:backup@otherhost:/srv/journal-backups
OFFSITE_TARGET=/var/backups/journal/offsite

COMPOSE_FILE=/opt/journal/deploy/docker-compose.prod.yml
# DB_SERVICE=db
# DB_CONTAINER=          # set to skip the compose lookup entirely
# DB_USER=journal
# DB_NAME=journal
