# cp .env.example .env and fill in. Consumed by docker-compose.prod.yml, which
# passes it to the API container. Never commit the filled-in copy.

# ---------------------------------------------------------------------------
# Stack-level (read by compose itself, not the app)
# ---------------------------------------------------------------------------
# The domain Caddy requests a certificate for. Its A/AAAA record must already
# point at this host or issuance fails.
JOURNAL_DOMAIN=journal.example.com

# Postgres superuser password for the db service. Also interpolated into
# DATABASE_URL by compose. URL-encode reserved characters (%40 for @).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# App — the full manifest with rationale is in backend/.env.example
# ---------------------------------------------------------------------------
# DATABASE_URL, TRUSTED_PROXY_IPS and AUTO_MIGRATE are set by
# docker-compose.prod.yml; ENABLE_DOCS=0 comes from the image. Do not set them
# here; compose wins and the duplicate only misleads.

ANTHROPIC_API_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# The API serves the SPA, so this is just the site root.
FRONTEND_URL=https://journal.example.com

# Registered redirect URI is the site root plus the route — no prefix:
#   https://journal.example.com/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Signed-out visitors resolve to the seeded demo user. Seed before enabling.
# PUBLIC_DEMO=1

# ---------------------------------------------------------------------------
# Spend caps (USD/day, UTC window, enforced by services/quota.py)
# ---------------------------------------------------------------------------
# Back these with a hard monthly limit on the Anthropic console key — these
# stop the app, not the key.
# Per demo visitor. The whole showcase shares one demo user, so this is the
# demo's daily ceiling, not a per-visitor allowance.
DEMO_DAILY_USD=2
# Service-wide kill-switch across all users and both LLM routes.
GLOBAL_DAILY_USD=5

# ---------------------------------------------------------------------------
# Must stay unset here
# ---------------------------------------------------------------------------
# GOOGLE_EMAIL, GOOGLE_APP_MASTER_TOKEN, GOODNOTES_PATH — the sync routes
# resolve their owner from GOOGLE_EMAIL and ignore the caller, so any signed-in
# user could sync into that account. Both connectors are local-machine only.
